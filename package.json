  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "echo \"No tests configured for Vite migration.\" && exit 0",
    "build:gh": "vite build --base /online-meeting-list/ && mkdir -p build/online-meeting-list && for p in build/*; do if [ \"$p\" = \"build/online-meeting-list\" ]; then continue; fi; mv \"$p\" build/online-meeting-list/; done",
    "predeploy": "pnpm build:gh",
    "deploy": "gh-pages -d build -r git@github-sm:spearheadmorrow/online-meeting-list.git",
    "serve:subpath": "node scripts/serve-subpath.js"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react-swc": "^3.0.0",
